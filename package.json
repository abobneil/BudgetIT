{
  "name": "budgetit",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run build --workspace @budgetit/db && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspace @budgetit/db && npm run build --workspaces --if-present",
    "rebuild:native:electron": "node scripts/rebuild-native-electron.cjs",
    "dist:win": "npm run build && npm run rebuild:native:electron && electron-builder --config electron-builder.yml --config.npmRebuild=false --win nsis --publish never",
    "release:win": "npm run dist:win",
    "smoke:packaged": "powershell -ExecutionPolicy Bypass -File scripts/release-smoke.ps1"
  },
  "dependencies": {
    "@budgetit/core": "file:packages/core",
    "@budgetit/db": "file:packages/db",
    "exceljs": "^4.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "electron-builder": "^26.0.12",
    "eslint": "^9.21.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}

